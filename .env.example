# Copy to .env.local. `pnpm dev` works with no settings at all, in paper mode.

# paper | devnet | mainnet
GEMDEX_MODE=paper

# Optional. Raises Collector Crypt rate limits. Ask for one in their Discord.
CC_API_KEY=

# Required outside paper mode.
SESSION_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
HELIUS_API_KEY=
JUPITER_API_KEY=
