# Copy to .env.local for local runs. `pnpm dev` works with no settings at all, in paper mode, and passes
# this file to the web app, the gateway and the worker.
# For Dokploy, deploy/dokploy.env.example splits these by app.
# Don't set DATABASE_URL here: `pnpm dev` starts its own Postgres and this file would override it.

# paper | devnet | mainnet
GEMDEX_MODE=paper

# ---------------------------------------------------------------------------
# Any mode (optional)
# ---------------------------------------------------------------------------
# Raises Collector Crypt rate limits. Ask for one in their Discord. Gateway and worker.
CC_API_KEY=
# Paper mode's admin page is open on your own machine. Set false on any public deployment. Gateway.
PAPER_OPEN_ADMIN=

# ---------------------------------------------------------------------------
# Devnet and mainnet
# ---------------------------------------------------------------------------
# Signs session tokens. A long random string. Gateway.
SESSION_SECRET=
# Wallet addresses that can open the admin page, comma separated. Gateway.
ADMIN_WALLETS=

# Privy (docs/LAUNCH.md, section 2). Use a separate Privy app for devnet and mainnet.
# Built into the site, so changing them needs a rebuild.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# Server side. Gateway (sign-in) and worker (signing).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTH_KEY=

# The treasury wallets the worker signs with, each as walletId:address (docs/LAUNCH.md, section 4).
PRIVY_WALLET_DROPS=
PRIVY_WALLET_VAULT=
PRIVY_WALLET_CASHBACK=
PRIVY_WALLET_FEE=
PRIVY_WALLET_FEE_PAYER=

# Solana RPC. For Helius, paste its full URL with the key in it; there is no separate Helius key.
# Worker, and the gateway for the $TENR access minimum. Devnet falls back to the public devnet RPC; mainnet requires it.
SOLANA_RPC_URL=
# The RPC the browser uses for wallet transactions. Defaults to the public mainnet RPC.
NEXT_PUBLIC_SOLANA_RPC=
# USDC mint for the browser. Defaults to mainnet USDC; set USDC-Dev's mint on devnet.
NEXT_PUBLIC_USDC_MINT=

# Token swaps for the fee pipeline. Worker.
JUPITER_API_KEY=
# $TENR's mint, once launched. Gateway and worker.
GEMDEX_TOKEN_MINT=

# Devnet without Privy only: the worker signs with local keys derived from this seed, or with the
# keys given per role as JSON. Mainnet refuses local keys.
GEMDEX_DEV_SEED=
GEMDEX_ROLE_KEYS=

# ---------------------------------------------------------------------------
# Mainnet only
# ---------------------------------------------------------------------------
# The last lock before real money moves. The value is in docs/LAUNCH.md, section 6. Read all of it first.
ALLOW_MAINNET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Two-letter country codes to block. Reads the country header Cloudflare or Vercel adds.
BLOCKED_COUNTRIES=
