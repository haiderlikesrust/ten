# What each Dokploy application holds. Never commit filled-in values.
# Blank values count as unset, so you can paste a block as is and fill the values in later.
# Every app runs in paper mode until you change GEMDEX_MODE (read docs/LAUNCH.md before devnet or mainnet).

# ---------------------------------------------------------------------------
# tenner-web: Environment -> Build-time Arguments
# NEXT_PUBLIC_ values are built into the site's scripts, so changing one needs a redeploy.
# No comments in this field: Dokploy hands each line to the build.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=https://tenner.trade/gateway
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_SIGNER_ID=
NEXT_PUBLIC_SOLANA_RPC=
NEXT_PUBLIC_USDC_MINT=
# NEXT_PUBLIC_GATEWAY_URL is the gateway's public URL, with no trailing slash: either a path on the site's
# domain (https://tenner.trade/gateway, live now) or its own subdomain (https://api.tenner.trade).
# NEXT_PUBLIC_USDC_MINT defaults to mainnet USDC; set USDC-Dev's mint on devnet.

# ---------------------------------------------------------------------------
# tenner-web: Environment -> Environment
# ---------------------------------------------------------------------------
# Two-letter country codes to block. Needs the domain behind Cloudflare.
BLOCKED_COUNTRIES=

# ---------------------------------------------------------------------------
# tenner-gateway: Environment
# ---------------------------------------------------------------------------
# --- Running now (paper mode) ---
# The Internal Connection URL of tenner-db.
DATABASE_URL=
GEMDEX_MODE=paper
# The site's exact origin, for CORS.
WEB_ORIGIN=https://tenner.trade
# Must be false on any public deployment, paper included. Otherwise everyone gets the admin page.
PAPER_OPEN_ADMIN=false
# A long random string. Signs session tokens.
SESSION_SECRET=
# Traefik is the only way in, so its X-Forwarded-For is the visitor's address. Also set in the image.
TRUST_PROXY=true
# --- Optional, any mode ---
# Raises Collector Crypt rate limits. Ask in their Discord.
CC_API_KEY=
# --- Devnet and mainnet (docs/LAUNCH.md) ---
# Reads $TENR balances for the access minimum (docs/FLYWHEEL.md). Devnet falls back to the public RPC.
SOLANA_RPC_URL=
# Wallet addresses that can open the admin page, comma separated.
ADMIN_WALLETS=
# Privy server credentials, for sign-in.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# $TENR mint, once launched.
GEMDEX_TOKEN_MINT=

# ---------------------------------------------------------------------------
# tenner-worker: Environment
# ---------------------------------------------------------------------------
# --- Running now (paper mode) ---
DATABASE_URL=
GEMDEX_MODE=paper
# --- Optional, any mode ---
CC_API_KEY=
# --- Devnet and mainnet (docs/LAUNCH.md) ---
# A paid Solana RPC URL. For Helius, its full URL with the key in it. Devnet falls back to the public RPC.
SOLANA_RPC_URL=
# Privy app credentials and authorization key (LAUNCH.md section 2). Always needed: users' trading wallets sign through it.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTH_KEY=
# Treasury wallets (LAUNCH.md section 4). ONE of the two per wallet, mixing is fine: a private key
# (the base58 string a wallet exports), or a Privy server wallet as walletId:address.
TREASURY_KEY_DROPS=
TREASURY_KEY_VAULT=
TREASURY_KEY_CASHBACK=
TREASURY_KEY_FEE=
TREASURY_KEY_FEE_PAYER=
PRIVY_WALLET_DROPS=
PRIVY_WALLET_VAULT=
PRIVY_WALLET_CASHBACK=
PRIVY_WALLET_FEE=
PRIVY_WALLET_FEE_PAYER=
# Token swaps for the fee pipeline.
JUPITER_API_KEY=
# $TENR mint, once launched.
GEMDEX_TOKEN_MINT=
# Devnet without Privy only: keys made from this seed for users and any treasury wallet left unset.
GEMDEX_DEV_SEED=
# --- Mainnet only ---
# The last lock before real money moves. The value is in docs/LAUNCH.md section 6.
ALLOW_MAINNET=
