# Paste each block into its Dokploy application. Never commit filled-in values.
# Every app runs in paper mode until you change GEMDEX_MODE (see docs/LAUNCH.md before devnet or mainnet).

# ---------------------------------------------------------------------------
# tenner-web: Environment -> Build-time Arguments
# NEXT_PUBLIC_ values are built into the site's scripts, so changing one needs a redeploy.
# ---------------------------------------------------------------------------
# The gateway's public URL, with no trailing slash. The live stream uses the same host over wss://.
NEXT_PUBLIC_GATEWAY_URL=https://api.tenner.trade
# Leave the Privy values empty for paper mode. That build has no wallet code in it.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_SIGNER_ID=
NEXT_PUBLIC_SOLANA_RPC=
NEXT_PUBLIC_USDC_MINT=

# tenner-web: Environment -> Environment (runtime)
# Two-letter codes. It reads the country header Cloudflare adds, so it only works with the domain behind Cloudflare.
BLOCKED_COUNTRIES=

# ---------------------------------------------------------------------------
# tenner-gateway: Environment
# ---------------------------------------------------------------------------
# The Internal Connection URL of tenner-db.
DATABASE_URL=
GEMDEX_MODE=paper
# The site's exact origin, for CORS.
WEB_ORIGIN=https://tenner.trade
# Must be false on any public deployment, paper included. Otherwise everyone gets the admin page.
PAPER_OPEN_ADMIN=false
# Wallet addresses that can open the admin page, comma separated.
ADMIN_WALLETS=
# A long random string. Required outside paper mode, and worth setting now.
SESSION_SECRET=
# Optional. Raises Collector Crypt rate limits.
CC_API_KEY=

# ---------------------------------------------------------------------------
# tenner-worker: Environment
# ---------------------------------------------------------------------------
DATABASE_URL=
GEMDEX_MODE=paper
CC_API_KEY=

# Devnet and mainnet only, on both the gateway and the worker (docs/LAUNCH.md has the full list):
# SOLANA_RPC_URL, PRIVY_APP_ID, PRIVY_APP_SECRET, PRIVY_AUTH_KEY, PRIVY_WALLET_DROPS, PRIVY_WALLET_VAULT,
# PRIVY_WALLET_CASHBACK, PRIVY_WALLET_FEE, PRIVY_WALLET_FEE_PAYER, JUPITER_API_KEY, GEMDEX_TOKEN_MINT, ALLOW_MAINNET
